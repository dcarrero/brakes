{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/main_checkout_guard.py\" pre-edit",
            "onFailure": "block",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge_guard.sh\"",
            "onFailure": "block",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/main_checkout_guard.py\" session-start",
            "statusMessage": "Updating the main checkout",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/main_checkout_guard.py\" stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_verify.sh\"",
            "statusMessage": "Running verify",
            "timeout": 630,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(gh pr edit * --add-label human-approved)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.test)",
      "Read(//**/.env.staging)",
      "Read(//**/secrets/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/local.properties)",
      "Read(//**/keystore.properties)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/secrets/**)",
      "Edit(//**/.agent-setup/lock.json)",
      "Edit(//**/tests/heldout/**)",
      "Read(//**/tests/heldout/**)"
    ]
  }
}
