[
  {
    "name": "Set up Python",
    "uses": {
      "repo": "actions/setup-python",
      "sha": "a26af69be951a213d495a4c3e4e4022e16d87065",
      "version": "v5"
    },
    "with": {
      "python-version": "3.13"
    }
  },
  {
    "name": "Restore pip cache",
    "uses": {
      "repo": "actions/cache/restore",
      "sha": "55cc8345863c7cc4c66a329aec7e433d2d1c52a9",
      "version": "v6.1.0"
    },
    "with": {
      "key": "${{ runner.os }}-pip-dbt-core-1.12.6-sqlfluff-4.4.0",
      "path": "~/.cache/pip"
    }
  },
  {
    "name": "Install dbt and sqlfluff",
    "run": "python -m pip install dbt-core==1.12.6 sqlfluff==4.4.0 sqlfluff-templater-dbt==4.4.0",
    "working-directory": "analytics/dbt"
  },
  {
    "name": "Save pip cache",
    "uses": {
      "repo": "actions/cache/save",
      "sha": "55cc8345863c7cc4c66a329aec7e433d2d1c52a9",
      "version": "v6.1.0"
    },
    "with": {
      "key": "${{ runner.os }}-pip-dbt-core-1.12.6-sqlfluff-4.4.0",
      "path": "~/.cache/pip"
    },
    "if": "github.ref == format('refs/heads/{0}', github.event.repository.default_branch)"
  }
]
